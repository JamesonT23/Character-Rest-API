<#import "layout.ftlh" as layout>

<@layout.page title="Character Not Found">

<div class="text-center py-5">

    <h1 class="display-5">Character Not Found</h1>

    <p class="lead mt-3">
        Sorry, we couldn't find the character you were looking for.
    </p>

    <p>
        The character may have been deleted or the ID may be incorrect.
    </p>

    <a href="/" class="btn btn-primary mt-3">
        Return to Gallery
    </a>

</div>

</@layout.page>