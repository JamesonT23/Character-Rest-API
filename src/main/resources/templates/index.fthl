
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Character Gallery</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">

            <a class="navbar-brand" href="/">
                Character Gallery
            </a>

            <div class="navbar-nav">
                <a class="nav-link active" href="/">Home</a>
                <a class="nav-link" href="/about">About</a>
                <a class="nav-link" href="/characters/new">Add a Character</a>
            </div>

        </div>
    </nav>

    <div class="container py-5">

        <h1 class="text-center">Fictional Character Gallery</h1>

        <p class="text-center">
            Explore some of the most iconic fictional characters.
        </p>

        <!-- Search and universe filter -->
        <form action="/" method="get" class="mb-5">

            <div class="row g-3">

                <div class="col-md-6">
                    <label for="name" class="form-label">
                        Search Characters
                    </label>

                    <input
                        type="text"
                        id="name"
                        name="name"
                        class="form-control"
                        placeholder="Search by character name"
                        value="${name!''}">
                </div>

                <div class="col-md-4">
                    <label for="universe" class="form-label">
                        Filter by Universe
                    </label>

                    <select id="universe" name="universe" class="form-select">

                        <option value="">All Universes</option>

                        <#list universes as item>
                            <option value="${item}"
                                <#if universe?? && universe == item>selected</#if>>
                                ${item}
                            </option>
                        </#list>

                    </select>
                </div>

                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        Search
                    </button>
                </div>

            </div>

            <div class="mt-2">
                <a href="/" class="btn btn-outline-secondary btn-sm">
                    Clear Search
                </a>
            </div>

        </form>

        <!-- Character gallery -->
        <div class="row g-4">

            <#list characters as character>

                <div class="col-md-6 col-lg-4">

                    <div class="card h-100">

                        <#if character.imageUrl?? && character.imageUrl?has_content>
                            <img
                                src="${character.imageUrl}"
                                class="card-img-top"
                                alt="${character.name}"
                                style="height: 250px; object-fit: contain;">
                        <#else>
                            <div class="bg-light text-center p-5">
                                <p class="text-muted">No image available</p>
                            </div>
                        </#if>

                        <div class="card-body">

                            <h2 class="card-title">
                                ${character.name}
                            </h2>

                            <p>
                                <strong>Universe:</strong>
                                ${character.universe! 'Unknown'}
                            </p>

                            <p>
                                <strong>Role:</strong>
                                ${character.role! 'Unknown'}
                            </p>

                            <p>
                                <strong>Species:</strong>
                                ${character.species! 'Unknown'}
                            </p>

                            <p class="card-text">
                                ${character.description}
                            </p>

                            <a href="/characters/${character.characterId?c}"
                               class="btn btn-primary">
                                View Details
                            </a>

                        </div>

                    </div>

                </div>

            <#else>

                <div class="col-12 text-center py-5">

                    <h3>No Characters Found</h3>

                    <p>
                        No characters matched your search.
                        Try another name or universe.
                    </p>

                    <a href="/" class="btn btn-primary">
                        View All Characters
                    </a>

                </div>

            </#list>

        </div>

    </div>

</body>
</html>
